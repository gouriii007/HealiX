# =====================================================================
# Healix Hospital Management System - Supabase Environment Variables
# =====================================================================
# Set these environment variables or place them in a local .env file.
# Do NOT commit your real .env file or credentials to source control.
#
# Connection Pooler (Recommended - works with IPv4 & IPv6):
# SUPABASE_DB_URL=jdbc:postgresql://aws-0-<REGION>.pooler.supabase.com:5432/postgres?sslmode=require
# SUPABASE_DB_USERNAME=postgres.<PROJECT_REF>
# SUPABASE_DB_PASSWORD=<YOUR_DATABASE_PASSWORD>
#
# Direct Connection (Requires IPv6 network or Supabase IPv4 add-on):
# SUPABASE_DB_URL=jdbc:postgresql://db.<PROJECT_REF>.supabase.co:5432/postgres?sslmode=require
# SUPABASE_DB_USERNAME=postgres
# SUPABASE_DB_PASSWORD=<YOUR_DATABASE_PASSWORD>
# =====================================================================

SUPABASE_DB_URL=jdbc:postgresql://aws-0-ap-south-1.pooler.supabase.com:5432/postgres?sslmode=require
SUPABASE_DB_USERNAME=postgres.your-project-ref
SUPABASE_DB_PASSWORD=your_supabase_database_password_here
SUPABASE_DB_DRIVER=org.postgresql.Driver
