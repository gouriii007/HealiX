    { "source": "/patient/appointments", "destination": "/patient/appointments/index.html" },
    { "source": "/patient/ai-assistant", "destination": "/patient/ai-assistant/index.html" },
    { "source": "/patient/hospitals", "destination": "/hospitals/index.html" },
    { "source": "/doctor/dashboard", "destination": "/doctor/dashboard/index.html" },
    { "source": "/hospital-admin/dashboard", "destination": "/hospital-admin/dashboard/index.html" },
    { "source": "/super-admin/dashboard", "destination": "/super-admin/dashboard/index.html" }
